  testcase nas_attach_complete_test1() runs on MTC {

    // security protected attach complete with activate default eps bearer context
    var octetstring nas_pdu := '275308324801074300035200c2'O;
        
    log(nas_pdu);
    
    var bitstring v_NasPduBitstring := oct2bit(nas_pdu);
    
    var NAS_UL_Message_Type v_NAS_UL_Message;
    var NasEmu_DecodedNasPduUL_Type v_DecodedNasPduUL;
      
    if (f_NasEmu_Decvalue(v_NasPduBitstring, v_NAS_UL_Message) != 0) {
      setverdict(fail);
    } else {
      v_DecodedNasPduUL.Msg := v_NAS_UL_Message;
    }
     
    log(v_DecodedNasPduUL);
     
    if (ischosen(v_NAS_UL_Message.sECURITY_PROTECTED_NAS_MESSAGE)) {
      setverdict(pass); 
    } else {
      setverdict(fail);
    }  
  }
  
  testcase nas_security_protected_detach_test1() runs on MTC {

    // security protected detach request
    var octetstring nas_pdu := '27bb1221a8030745090bf600f11080010112345678'O;
        
    log(nas_pdu);
    
    var bitstring v_NasPduBitstring := oct2bit(nas_pdu);
    
    var NAS_UL_Message_Type v_NAS_UL_Message;
    var NasEmu_DecodedNasPduUL_Type v_DecodedNasPduUL;
      
    if (f_NasEmu_Decvalue(v_NasPduBitstring, v_NAS_UL_Message) != 0) {
      setverdict(fail);
    } else {
      v_DecodedNasPduUL.Msg := v_NAS_UL_Message;
    }
     
    log(v_DecodedNasPduUL);
     
    if (ischosen(v_NAS_UL_Message.sECURITY_PROTECTED_NAS_MESSAGE)) {
      setverdict(pass); 
    } else {
      setverdict(fail);
    }

    // the detach request is ciphered with EEA0, decode the contained message
    v_DecodedNasPduUL := f_NasEmu_DecodeMsg(v_NAS_UL_Message.sECURITY_PROTECTED_NAS_MESSAGE.nasMessage);
    log(v_DecodedNasPduUL);

    if (ischosen(v_DecodedNasPduUL.Msg) and ischosen(v_DecodedNasPduUL.Msg.dETACH_REQUEST_MO)) {
      setverdict(pass); 
    } else {
      setverdict(fail);
    }
  }
  
  
  
  testcase TAI_test() runs on MTC system SYSTEM {
 
    // Create a TAI List object   
    var NAS_PlmnId       v_PLMN := '00F110'O;
    var NAS_Lac          v_LAC := '0001'O;
    var TrackingAreaCode v_Tac := int2bit (1, 16);
    var template (omit)  LocAreaId               v_LAI := omit;
    var template (value) TrackingAreaIdList      v_TaiList := cs_TAIListNonConsecutive_lv ( v_PLMN, { bit2oct( v_Tac ) } );
  
    // Log TTCN3 struct
    log(v_TaiList);
    
    // RAW encode and log
    var bitstring encoded := encvalue(v_TaiList);
    log(bit2oct(encoded));
    
    setverdict(pass);                                                               
  }
  
  testcase ESM_MessageContainer_test() runs on MTC system SYSTEM {
 
    // Create a container   
    var ESM_MessageContainer esm;
    
    esm.iei := omit;
    esm.iel := 0;
    esm.esmPdu := ''O;
    
    // Log TTCN3 struct
    log(esm);
    
    // RAW encode and log
    var bitstring encoded := encvalue(esm);
    log(bit2oct(encoded));
    
    setverdict(pass);                                                               
  }
  
  type record SIMPLE_ATTACH_ACCEPT {
    SecurityHeaderType                  securityHeaderType,                     /* cl. 9.3.1    M V 1/2 */
  	ProtocolDiscriminator               protocolDiscriminator,                  /* cl. 9.2      M V 1/2 */
  	MessageType                         messageType,                            /* cl. 9.8      M V 1   */
  	SpareHalfOctet                      spareHalfOctet,                         /* cl. 9.9.2.9  M V 1/2 */
	EPS_AttachResult                    epsAttachResult,                        /* cl. 9.9.3.10  M V 1/2 */
	GPRS_Timer                          t3412,                                  /* cl. 9.9.3.16 M V 1   */
    TrackingAreaIdList                  taiList,                                /* cl. 9.9.3.33 M LV 7-97 */
    ESM_MessageContainer                esmMessage
  } with {
  	encode "RAW"; 
  };
  
  testcase Attach_accept_partial_test() runs on MTC system SYSTEM {
 
    // Create a container   
    var ATTACH_ACCEPT attach_accept;
    
    attach_accept.securityHeaderType := '0000'B;
    attach_accept.protocolDiscriminator := '1111'B;
    attach_accept.epsAttachResult.resultValue := '001'B;
    attach_accept.epsAttachResult.spare := '0'B;
    attach_accept.messageType := '00000000'B;
    attach_accept.spareHalfOctet := '0'H;
    attach_accept.t3412.unit := '111'B;
    attach_accept.t3412.iei := omit;
    attach_accept.t3412.timerValue := '00000'B;
    
    
    attach_accept.guti.iei := '50'O;
    attach_accept.guti.iel := 11;
    attach_accept.guti.idDigit1 := '1111'B;
    attach_accept.guti.oddEvenInd := '0'B;
    attach_accept.guti.typeOfId := '110'B;
    attach_accept.guti.otherDigits := '00F11080010112345678'O;
    
    attach_accept.lai := omit;
    attach_accept.msIdentity := omit;
    attach_accept.emmCause := omit;
    attach_accept.t3402 := omit;
    attach_accept.t3423 := omit;
    attach_accept.equivalentPlmns := omit;
    attach_accept.emergencyNumberList := omit;
    attach_accept.epsNetworkFeatureSupport.iei := '64'O;
    attach_accept.epsNetworkFeatureSupport.iel := '01'O;
    attach_accept.epsNetworkFeatureSupport.spareBits := '0000000'B;
    attach_accept.epsNetworkFeatureSupport.imsVoPS := '1'B;
    attach_accept.addUpdateResult := omit;
    
    
    
    
    // Create a TAI List object   
    var NAS_PlmnId       v_PLMN := '00F110'O;
    var NAS_Lac          v_LAC := '0001'O;
    var TrackingAreaCode v_Tac := int2bit (1, 16);
    var template (omit)  LocAreaId               v_LAI := omit;
    var template (omit) TrackingAreaIdList      v_TaiList := cs_TAIListNonConsecutive_lv ( v_PLMN, { bit2oct( v_Tac ) } );
     
    attach_accept.taiList := valueof(v_TaiList);
    
    attach_accept.esmMessage.iei := omit;
    attach_accept.esmMessage.iel := 0;
    attach_accept.esmMessage.esmPdu := ''O;
    
    // Log TTCN3 struct
    log(attach_accept);
    
    // RAW encode and log
    var bitstring encoded := encvalue(attach_accept);
    log(bit2oct(encoded));
    
    setverdict(pass);                                                               
  }
  
}
