module NAS_Codec_Test
{

  import from NasEmu_AspTypes all;
  import from NasEmu all;
  import from NasEmu_Templates all;
  
  import from EUTRA_RRC_ASN1_Definitions language "ASN.1:1997" all;
  
  import from EPS_NAS_MsgContainers all;
  import from EPS_NAS_Templates all;
  import from EPS_NAS_TypeDefs all;
  import from NAS_CommonTypeDefs all;

  import from MTC_Component all;
  import from MTC_Main all;
  
  
  testcase nas_attach_request_test1() runs on MTC {
  
    // connection request moto g4
    var octetstring nas_pdu := '07410108091010000000001002E06000040201D011'O;  
    log(nas_pdu);
    
    var bitstring v_NasPduBitstring := oct2bit(nas_pdu);
    log(v_NasPduBitstring);
    
    
    // self-defined decoding test
    var NAS_UL_Message_Type v_NAS_UL_Message;
    
    //v_NAS_UL_Message := f_convert_to_3GPP_NAS_PDU(nas_pdu_dec);
    
    
    v_NAS_UL_Message := dec_3GPP_PDU_NAS_EPS(nas_pdu);
    log(v_NAS_UL_Message);
    
    
    var NasEmu_DecodedNasPduUL_Type v_DecodedNasPduUL;
    
    if (f_NasEmu_Decvalue(v_NasPduBitstring, v_NAS_UL_Message) != 0) {
      setverdict(fail);
    } else {
      v_DecodedNasPduUL.Msg := v_NAS_UL_Message;
    }
    
    log(v_DecodedNasPduUL);
    
    if (ischosen(v_NAS_UL_Message.aTTACH_REQUEST)) {
      setverdict(pass); 
    } else {
      setverdict(fail);
    }
  }
  
  testcase nas_attach_request_test2() runs on MTC {

	// connection request moto g4
	var octetstring nas_pdu := '07417208991007000000994605f070c040180005025ad011d15c0a003103e5e0349011035758a65d0100c1'O;
	// connection request srs
//	var octetstring nas_pdu := '07410108091010000000001002E06000040201D011'O;

	// attach request with Guti
    //17 E2 C8 E4 F5 02 07 41 11 0B F6 00 F1 10 80 01 01 85 89 11 2E 02 E0 60 00 04 02 01 D0 11 E0
	
	log(nas_pdu);
	
	var bitstring v_NasPduBitstring := oct2bit(nas_pdu);
	
    var NAS_UL_Message_Type v_NAS_UL_Message;
    var NasEmu_DecodedNasPduUL_Type v_DecodedNasPduUL;
    
	if (f_NasEmu_Decvalue(v_NasPduBitstring, v_NAS_UL_Message) != 0) {
      setverdict(fail);
    } else {
      v_DecodedNasPduUL.Msg := v_NAS_UL_Message;
    }
    
    log(v_DecodedNasPduUL);
    

    if (ischosen(v_NAS_UL_Message.aTTACH_REQUEST)) {
      setverdict(pass); 
    } else {
      setverdict(fail);
    }  
  }
  
  testcase nas_attach_request_test3() runs on MTC {

	// connection request with attach request with GUTI
	var octetstring nas_pdu := '17E2C8E4F5020741110BF600F1108001018589112E02E06000040201D011E0'O;
	
	log(nas_pdu);
	
	var bitstring v_NasPduBitstring := oct2bit(nas_pdu);
	
    var NAS_UL_Message_Type v_NAS_UL_Message;
    var NasEmu_DecodedNasPduUL_Type v_DecodedNasPduUL;
    
	if (f_NasEmu_Decvalue(v_NasPduBitstring, v_NAS_UL_Message) != 0) {
      setverdict(fail);
    } else {
      v_DecodedNasPduUL.Msg := v_NAS_UL_Message;
    }
    
    log(v_DecodedNasPduUL);

    if (not ischosen(v_NAS_UL_Message.sECURITY_PROTECTED_NAS_MESSAGE)) {
      setverdict(fail);
      stop;
    }

    // the attach request is integrity protected, decode the contained message
    v_DecodedNasPduUL := f_NasEmu_DecodeMsg(v_NAS_UL_Message.sECURITY_PROTECTED_NAS_MESSAGE.nasMessage);
    log(v_DecodedNasPduUL);

    if (ischosen(v_DecodedNasPduUL.Msg) and ischosen(v_DecodedNasPduUL.Msg.aTTACH_REQUEST)) {
      setverdict(pass);
    } else {
      setverdict(fail);
    }
  }

